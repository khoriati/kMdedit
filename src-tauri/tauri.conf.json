{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "kMdedit",
  "version": "1.0.0",
  "identifier": "br.com.khori.kmdedit",
  "build": {
    "frontendDist": "../ui"
  },
  "app": {
    "windows": [
      { "label": "main", "title": "kMdedit", "width": 1080, "height": 780, "resizable": true }
    ],
    "security": {
      "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob:; script-src 'self'"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all"
  }
}
